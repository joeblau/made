<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>made</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleName</key>
	<string>made</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>NSPrincipalClass</key>
	<string>PilotApplication</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Isolate installer launchd calls from made's main thread. This is
	     intentional even though made is not sandboxed: SMJobRemove can
	     wait indefinitely inside Sparkle's in-process installer launcher. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/joeblau/made/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>BIQoEzT2ALEKrU/qHI6ZCBZXrHMmq+GQxRgy9dCpEBg=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>made listens for push-to-talk dictation from the Walkie app.</string>
	<key>NSCameraUsageDescription</key>
	<string>made accesses an attached iPhone camera feed so its Device pane can preview, capture, and record the device screen.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>made receives wireless iPhone and iPad screen sharing, connects to Walkie and Kneeboard, and discovers Macs over the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_blau-frames._tcp</string>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
		<string>_blau-annotate._tcp</string>
		<string>_blau-sync._tcp</string>
		<string>_blau-sync._udp</string>
		<string>_rfb._tcp</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>made Workspace Pane</string>
			<key>UTTypeIdentifier</key>
			<string>app.blau.pilot.pane</string>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>made Note Tab</string>
			<key>UTTypeIdentifier</key>
			<string>app.blau.pilot.note-tab</string>
		</dict>
	</array>
</dict>
</plist>
