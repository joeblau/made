{
  "name": "rendezvous",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-types.mjs && tsc --noEmit",
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "lint": "eslint .",
    "start": "wrangler dev --var ENVIRONMENT:development",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:list": "wrangler deployments list",
    "rollback": "wrangler rollback",
    "types": "wrangler types --include-runtime=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261023.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
