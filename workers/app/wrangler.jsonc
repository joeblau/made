{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blau-app",
  "main": "worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Run in front of the existing blau-web Custom Domain. Other paths continue
  // to use the Astro site through the MADE_SITE service binding.
  "routes": [{ "pattern": "blau.app/*", "zone_name": "blau.app" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "blau-app" },
    { "binding": "MADE_SITE", "service": "blau-web" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
