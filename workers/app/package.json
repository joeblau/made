{
  "name": "blau-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bun run cf-typegen && opennextjs-cloudflare build",
    "build:next": "next build",
    "check": "bun run cf-typegen && next typegen && tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "deploy:list": "wrangler deployments list",
    "rollback": "wrangler rollback"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3",
    "wrangler": "4.135.0"
  }
}
