{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Astro emits /made URLs; the build stages files under .worker-assets/made
  // so the asset server handles the unchanged incoming URL, including redirects.
  "name": "web-made",
  "compatibility_date": "2026-06-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.worker-assets",
    // Serve Astro's generated 404.html for unknown paths (falls back to a
    // default 404 if the site has no 404 page).
    "not_found_handling": "404-page"
  },

  // Internal service only. The blau-app parent owns the blau.app domain.
  "routes": []
}
