<div class="cockpit-bg" aria-hidden="true">
  <canvas data-cockpit-scene></canvas>
  <canvas data-cockpit-hud></canvas>
  <div class="cockpit-bg__vignette"></div>
</div>

<script>
  // The scene is decorative, so the ~535KB three.js bundle must never compete
  // with first paint: load it after `load` on an idle slot, and skip it
  // entirely under prefers-reduced-motion (the CSS background remains).
  const start = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // requestIdleCallback is unavailable on Safari < 18.
    const idle = window.requestIdleCallback
      ? (cb: () => void) => window.requestIdleCallback(cb, { timeout: 2000 })
      : (cb: () => void) => setTimeout(cb, 1);
    idle(() => import('../scripts/f35-cockpit.js').then((m) => m.initCockpit()));
  };
  if (document.readyState === 'complete') start();
  else addEventListener('load', start, { once: true });
</script>
