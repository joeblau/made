<div class="cockpit-bg" aria-hidden="true">
  <canvas data-cockpit-scene></canvas>
  <canvas data-cockpit-hud></canvas>
  <div class="cockpit-bg__vignette"></div>
</div>

<script>
  // The scene is decorative, so the ~578KB three.js chunk must never compete
  // with first paint: only this small loader is in the page's critical script
  // graph. It fetches the scene by dynamic import after `load` on an idle
  // slot, and keeps the themed background and scrim instead under reduced
  // motion, Save-Data, 2G, missing WebGL2, or a failed fetch.
  import { loadCockpitWhenIdle } from '../scripts/cockpit-loader.js';
  loadCockpitWhenIdle();
</script>
