---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'default' | 'lg';
  rounded?: boolean;
  class?: string;
  href?: string;
  target?: '_blank' | '_self';
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  title?: string;
  'aria-label'?: string;
  'data-qr'?: string;
}

const {
  variant = 'primary',
  size = 'default',
  rounded = false,
  class: className,
  href,
  target,
  rel,
  ...props
} = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element
  data-slot="button"
  data-variant={variant}
  data-size={size}
  class:list={['button', rounded && 'button--rounded', className]}
  href={href}
  target={target}
  rel={rel}
  {...props}
>
  <slot />
</Element>
