<div
  class="usage"
  role="img"
  aria-label="Cockpit's Plan Usage panel tracking Claude, Codex, Kimi, and Grok quotas — Claude weekly at 54%, Codex weekly at 2%, Kimi weekly limit at 63%, Grok not signed in"
>
  <div class="usage__tabs">
    <span class="usage__tab">Actions</span>
    <span class="usage__tab">Tasks</span>
    <span class="usage__tab">Commits</span>
    <span class="usage__tab">Files</span>
    <span class="usage__tab usage__tab--active">Usage</span>
  </div>

  <div class="usage__head">
    <svg class="usage__head-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 20v-6M10 20V5M15 20v-9M20 20v-13" />
    </svg>
    <span class="usage__title">Plan Usage</span>
    <svg class="usage__refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-2.64-6.36M21 4v5h-5" />
    </svg>
  </div>

  <div class="usage__cards">
    <section class="usage-card">
      <header class="usage-card__head">
        <svg class="usage-card__icon usage-card__icon--claude" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2c.55 5.5 3.95 8.9 9.45 9.45-5.5.55-8.9 3.95-9.45 9.45-.55-5.5-3.95-8.9-9.45-9.45C8.05 10.9 11.45 7.5 12 2z" />
        </svg>
        <h3 class="usage-card__name">Claude</h3>
        <span class="usage-card__badge usage-card__badge--claude">Max</span>
      </header>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">5-hour</span>
          <span class="meter__pct meter__pct--claude">0%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--claude meter__fill--0"></span></div>
        <p class="meter__reset">resets in 4h 3m</p>
      </div>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">Weekly</span>
          <span class="meter__pct meter__pct--claude">54%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--claude meter__fill--54"></span></div>
        <p class="meter__reset">resets in 3d 4h</p>
      </div>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">Weekly (Fable)</span>
          <span class="meter__pct meter__pct--fable">93%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--fable meter__fill--93"></span></div>
        <p class="meter__reset">resets in 3d 4h</p>
      </div>
    </section>

    <section class="usage-card">
      <header class="usage-card__head">
        <svg class="usage-card__icon usage-card__icon--codex" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 6 3 12l5 6M16 6l5 6-5 6" />
        </svg>
        <h3 class="usage-card__name">Codex</h3>
        <span class="usage-card__badge usage-card__badge--codex">Pro</span>
      </header>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">Weekly</span>
          <span class="meter__pct meter__pct--codex">2%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--codex meter__fill--2"></span></div>
        <p class="meter__reset">resets in 6d 21h</p>
      </div>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">Gpt-5.3-Codex-Spark · Weekly</span>
          <span class="meter__pct meter__pct--codex">0%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--codex meter__fill--0"></span></div>
        <p class="meter__reset">resets in 6d 23h</p>
      </div>
      <div class="usage-card__credits">
        <span>Credits</span>
        <strong>177.97 credits</strong>
      </div>
    </section>

    <section class="usage-card">
      <header class="usage-card__head">
        <svg class="usage-card__icon usage-card__icon--kimi" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z" />
          <path d="M18 3.5c.14 1.36 1 2.22 2.36 2.36C19 6 18.14 6.86 18 8.22c-.14-1.36-1-2.22-2.36-2.36C17 5.72 17.86 4.86 18 3.5z" />
        </svg>
        <h3 class="usage-card__name">Kimi</h3>
        <span class="usage-card__badge usage-card__badge--kimi">Moderate</span>
      </header>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">Weekly limit</span>
          <span class="meter__pct meter__pct--kimi">63%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--kimi meter__fill--63"></span></div>
        <p class="meter__reset">resets in 16h 23m</p>
      </div>
      <div class="meter">
        <div class="meter__row">
          <span class="meter__label">5h limit</span>
          <span class="meter__pct meter__pct--kimi">10%</span>
        </div>
        <div class="meter__bar"><span class="meter__fill meter__fill--kimi meter__fill--10"></span></div>
        <p class="meter__reset">resets in 3h 23m</p>
      </div>
    </section>

    <section class="usage-card">
      <header class="usage-card__head">
        <svg class="usage-card__icon usage-card__icon--grok" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" />
        </svg>
        <h3 class="usage-card__name">Grok</h3>
      </header>
      <p class="usage-card__note">
        Not signed in. Run <code>grok</code> in a terminal to log in, then refresh.
      </p>
      <span class="usage-card__setup">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
        Set up
      </span>
    </section>
  </div>
</div>
