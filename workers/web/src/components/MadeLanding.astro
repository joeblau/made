---
import Layout from '../layouts/Layout.astro';
import CapabilityRail from './CapabilityRail.astro';
import CompanionApps from './CompanionApps.astro';
import Hero from './Hero.astro';
import SecuritySection from './SecuritySection.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import WorkflowShowcase from './WorkflowShowcase.astro';
---

<Layout
  title="made — One cockpit for every agent"
  description="made is a multimodal agentic development environment for macOS, with iOS, iPadOS, and watchOS companions. Run agents, code, preview, and ship from one cockpit."
>
  <SiteHeader />
  <main id="content">
    <Hero />
    <WorkflowShowcase />
    <CapabilityRail />
    <CompanionApps />
    <SecuritySection />
  </main>
  <SiteFooter />
</Layout>

<script>
  import { initSite } from '../scripts/site.js';
  initSite();
</script>
