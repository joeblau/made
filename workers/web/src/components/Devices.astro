<section class="section" id="devices">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="eyebrow">The crew</p>
      <h2 class="h2">
        Four apps.<br />
        <span class="h2--muted">One formation.</span>
      </h2>
      <p class="lead">
        Every Apple device you own becomes a control surface for the work
        happening on your Mac — paired explicitly, encrypted end to end.
      </p>
    </header>
    <div class="devices">
      <article class="device" data-reveal>
        <div class="device__glyph">
          <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="22" y="6" width="52" height="36" rx="4" />
            <path d="M14 52h68M14 52l6-6h56l6 6" />
            <path d="M38 18l8 6-8 6M50 30h10" stroke="var(--accent)" />
          </svg>
        </div>
        <p class="device__tag">macOS</p>
        <h3>Cockpit</h3>
        <p>
          The cockpit. Terminals, editing, previews, GitHub, device capture, and
          remote screens in one native window.
        </p>
      </article>
      <article class="device d-1" data-reveal>
        <div class="device__glyph">
          <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="34" y="4" width="28" height="56" rx="6" />
            <path d="M44 9h8" />
            <path d="M44 22l5 4-5 4M52 30h6" stroke="var(--accent)" />
          </svg>
        </div>
        <p class="device__tag">iOS</p>
        <h3>Walkie</h3>
        <p>
          A precision trackpad, voice transcription, settings, and encrypted
          peer messaging — from your pocket.
        </p>
      </article>
      <article class="device d-2" data-reveal>
        <div class="device__glyph">
          <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="20" y="8" width="56" height="44" rx="6" />
            <path d="M48 47.5v.5" />
            <path d="M32 24c6-6 14-6 20 0M44 40l12-12" stroke="var(--accent)" />
          </svg>
        </div>
        <p class="device__tag">iPadOS</p>
        <h3>Kneeboard</h3>
        <p>
          Mirrors a Cockpit window in low-latency HEVC and returns normalized
          PencilKit annotations. Stage Manager ready.
        </p>
      </article>
      <article class="device d-3" data-reveal>
        <div class="device__glyph">
          <svg viewBox="0 0 96 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M40 8h16l2 8H38l2-8ZM38 48h20l-2 8H40l-2-8Z" />
            <rect x="34" y="16" width="28" height="32" rx="8" />
            <path d="M44 30l5 4-5 4M52 38h6" stroke="var(--accent)" />
          </svg>
        </div>
        <p class="device__tag">watchOS</p>
        <h3>Trigger</h3>
        <p>
          Short-lived terminal gestures from your wrist, relayed live through
          your paired Walkie.
        </p>
      </article>
    </div>
  </div>
</section>
