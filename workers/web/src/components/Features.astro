---
const featureCards = [
  {
    title: 'Cockpit',
    copy:
      'A focused macOS cockpit with terminals, editing, and GitHub flow in one place.',
  },
  {
    title: 'Walkie',
    copy:
      'Use your iPhone as a precise, private control surface while your mac stays on.',
  },
  {
    title: 'Kneeboard',
    copy:
      'Mirror your main screen to iPad and annotate directly for fast visual feedback.',
  },
  {
    title: 'Trigger',
    copy:
      'Issue short terminal gestures from your watch with minimal context and quick actions.',
  },
  {
    title: 'Collaboration',
    copy:
      'Pairing and messaging are explicit and short-lived by design, with transparent trust boundaries.',
  },
  {
    title: 'Review loop',
    copy:
      'Approve, refine, and ship changes without leaving the same workflow context.',
  },
];

const tags = [
  'terminal',
  'swift',
  'xcode',
  'workflow',
  'macOS',
  'iPhone',
  'iPad',
  'watchOS',
  'GitHub',
  'agents',
  'encryption',
  'pairing',
  'preview',
  'live',
  'secure',
  'wireless',
  'HEVC',
  'clipboard',
  'zero-trust',
];
---

<section class="section section--features" id="features">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="eyebrow">features</p>
      <h2 class="h2">
        Everything you need for modern Apple development.
      </h2>
      <p class="lead">
        No marketing noise, just the primitives you actually ship with.
      </p>
    </header>
    <div class="feature-stack">
      <div class="tag-cloud" aria-hidden="true">
        {tags.map((tag) => <span class="tag-cloud__word">{tag}</span>)}
      </div>
      <div class="features-grid">
        {featureCards.map((feature) => (
          <article class="feature-card" data-reveal>
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
