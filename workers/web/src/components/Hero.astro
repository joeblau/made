---
import { MACOS_RELEASE_URL } from '../data/downloads';
import CockpitBackground from './CockpitBackground.astro';
import CockpitScreenshot from './CockpitScreenshot.astro';
import AppleIcon from './ui/AppleIcon.astro';
import Button from './ui/Button.astro';
---

<section class="hero" id="top" aria-labelledby="page-title" data-hero>
  <CockpitBackground />
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="eyebrow hero__eyebrow"><span class="status-dot" aria-hidden="true"></span>MULTIMODAL AGENTIC DEVELOPMENT ENVIRONMENT</p>
    <h1 id="page-title">
      <span class="hero__line"><span>Every agent.</span></span>
      <span class="hero__line"><span>Every surface.</span></span>
      <span class="hero__line hero__line--accent"><span>One cockpit.</span></span>
    </h1>
    <p class="hero__lede">made brings parallel agents, code, previews, devices, and delivery into one native Apple workspace.</p>
    <div class="hero__actions">
      <Button
        rounded
        size="lg"
        href={MACOS_RELEASE_URL}
        title="Download Cockpit for macOS 26 or later — Apple silicon and Intel"
      >
        <AppleIcon />
        <span>Download for macOS</span>
      </Button>
      <a class="hero__explore" href="#workflows">Explore the cockpit <span aria-hidden="true">↓</span></a>
    </div>
    <p class="hero__compatibility">macOS 26+ <span aria-hidden="true">·</span> Apple silicon &amp; Intel</p>
  </div>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__stage-topline" aria-hidden="true">
      <span><span class="status-dot"></span> COCKPIT / WORKSPACE</span>
      <span>READY WHEN YOU ARE</span>
    </div>
    <CockpitScreenshot
      scene="workspace"
      alt="Cockpit with two parallel agent terminals, project workspaces, and passing tests"
      loading="eager"
    />
  </div>
  <a class="hero__scroll" href="#workflows" aria-label="Scroll to explore Cockpit workflows">
    <span>SCROLL TO EXPLORE</span><span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>
