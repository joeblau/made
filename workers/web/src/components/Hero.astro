---
import { Cuer } from 'cuer';
import Button from './ui/Button.astro';

const WALKIE_TESTFLIGHT = 'https://testflight.apple.com/join/Q2G2q5ts';
const KNEEBOARD_TESTFLIGHT = 'https://testflight.apple.com/join/NsVkk4Rq';
---

<section class="landing" aria-labelledby="page-title">
  <div class="landing__content">
    <div class="landing__intro">
      <h1 id="page-title">made</h1>
      <p class="landing__tagline">Multimodal Agentic Development Environment</p>
    </div>

    <div class="landing__actions" aria-label="Downloads">
      <div class="landing__download">
        <h2>made</h2>
        <Button rounded type="button" disabled title="Coming soon">
          <svg viewBox="0 0 24 24" data-icon="inline-start" aria-hidden="true">
            <path d="M17.05 12.54c.02 2.22 1.95 2.96 1.97 2.97-.02.05-.31 1.06-1.02 2.1-.61.9-1.25 1.8-2.26 1.82-.98.02-1.3-.59-2.43-.59-1.12 0-1.48.57-2.41.61-.97.04-1.71-.97-2.33-1.86-1.27-1.84-2.24-5.2-.94-7.47a3.62 3.62 0 0 1 3.08-1.86c.96-.02 1.87.65 2.43.65.56 0 1.62-.8 2.73-.69.46.02 1.77.19 2.61 1.42-.07.04-1.56.91-1.54 2.9ZM15.14 7.05c.51-.62.86-1.49.76-2.36-.74.03-1.64.5-2.17 1.11-.48.55-.9 1.44-.78 2.28.83.06 1.67-.42 2.19-1.03Z" />
          </svg>
          <span>Download for macOS</span>
        </Button>
      </div>

      <div class="landing__download">
        <h2>Walkie/Trigger</h2>
        <Button
          rounded
          variant="secondary"
          href={WALKIE_TESTFLIGHT}
          target="_blank"
          rel="noreferrer"
          title="Download Walkie with TestFlight"
          data-qr="walkie"
        >
          <svg viewBox="0 0 24 24" data-icon="inline-start" aria-hidden="true">
            <path d="M17.05 12.54c.02 2.22 1.95 2.96 1.97 2.97-.02.05-.31 1.06-1.02 2.1-.61.9-1.25 1.8-2.26 1.82-.98.02-1.3-.59-2.43-.59-1.12 0-1.48.57-2.41.61-.97.04-1.71-.97-2.33-1.86-1.27-1.84-2.24-5.2-.94-7.47a3.62 3.62 0 0 1 3.08-1.86c.96-.02 1.87.65 2.43.65.56 0 1.62-.8 2.73-.69.46.02 1.77.19 2.61 1.42-.07.04-1.56.91-1.54 2.9ZM15.14 7.05c.51-.62.86-1.49.76-2.36-.74.03-1.64.5-2.17 1.11-.48.55-.9 1.44-.78 2.28.83.06 1.67-.42 2.19-1.03Z" />
          </svg>
          <span>Download for iOS</span>
        </Button>
      </div>

      <div class="landing__download">
        <h2>Kneeboard</h2>
        <Button
          rounded
          variant="secondary"
          href={KNEEBOARD_TESTFLIGHT}
          target="_blank"
          rel="noreferrer"
          title="Download Kneeboard with TestFlight"
          data-qr="kneeboard"
        >
          <svg viewBox="0 0 24 24" data-icon="inline-start" aria-hidden="true">
            <path d="M17.05 12.54c.02 2.22 1.95 2.96 1.97 2.97-.02.05-.31 1.06-1.02 2.1-.61.9-1.25 1.8-2.26 1.82-.98.02-1.3-.59-2.43-.59-1.12 0-1.48.57-2.41.61-.97.04-1.71-.97-2.33-1.86-1.27-1.84-2.24-5.2-.94-7.47a3.62 3.62 0 0 1 3.08-1.86c.96-.02 1.87.65 2.43.65.56 0 1.62-.8 2.73-.69.46.02 1.77.19 2.61 1.42-.07.04-1.56.91-1.54 2.9ZM15.14 7.05c.51-.62.86-1.49.76-2.36-.74.03-1.64.5-2.17 1.11-.48.55-.9 1.44-.78 2.28.83.06 1.67-.42 2.19-1.03Z" />
          </svg>
          <span>Download for iPad</span>
        </Button>
      </div>
    </div>
  </div>

  <dialog class="qr-dialog" data-qr-dialog>
    <h2 class="qr-dialog__title" data-qr-title>Scan to install</h2>
    <div class="qr-dialog__code" data-qr-code="walkie">
      <Cuer value={WALKIE_TESTFLIGHT} />
    </div>
    <div class="qr-dialog__code" data-qr-code="kneeboard" hidden>
      <Cuer value={KNEEBOARD_TESTFLIGHT} />
    </div>
    <p class="qr-dialog__hint">
      Point your camera at the code to open TestFlight.
    </p>
    <Button rounded variant="secondary" type="button" data-qr="close">Close</Button>
  </dialog>

  <footer class="landing__footer">
    <nav aria-label="Social links">
      <a href="https://github.com/joeblau/made" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://x.com/joeblau" target="_blank" rel="noreferrer">X</a>
    </nav>
  </footer>
</section>

<script>
  import { initQrDownload } from '../scripts/qr-download.js';
  initQrDownload();
</script>
