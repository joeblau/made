{
  "name": "blau-made",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-build-size.mjs && node scripts/check-security-headers.mjs && node scripts/prepare-worker-assets.mjs",
    "check": "astro check",
    "check:size": "node scripts/check-build-size.mjs",
    "lint": "eslint .",
    "preview": "astro preview",
    "preview:worker": "wrangler dev --port 8788 --inspector-port 9230",
    "test": "node --test test/*.test.mjs",
    "deploy": "wrangler deploy",
    "deploy:list": "wrangler deployments list",
    "rollback": "wrangler rollback"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "astro": "7.4.2",
    "cuer": "0.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
