---
interface Props {
  scene: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  scene,
  alt,
  width = 2880,
  height = 1920,
  loading = 'lazy',
  class: className,
} = Astro.props;

if (!/^[a-z][a-z-]*$/.test(scene)) {
  throw new Error(`Invalid Cockpit screenshot scene: ${scene}`);
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const source = (theme: 'light' | 'dark') => `${base}/screenshots/cockpit/cockpit-${scene}-${theme}.png`;
---

<picture class:list={['product-shot', className]} data-theme-picture>
  <source data-appearance="dark" media="(prefers-color-scheme: dark)" srcset={source('dark')} />
  <img
    src={source('light')}
    {alt}
    {width}
    {height}
    {loading}
    decoding="async"
  />
</picture>
