{
  "name": "made",
  "private": true,
  "type": "module",
  "workspaces": ["workers/*"],
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "devalue": "5.9.4",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.3.2",
    "postcss": "8.5.31",
    "qr": "0.5.5",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "svgo": "4.1.0",
    "undici": "7.29.1",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "audit": "bun audit",
    "xcodegen": "apple/bin/install-xcodegen.sh generate --spec apple/project.yml --project apple",
    "made": "bun run cockpit",
    "screenshots:cockpit": "apple/bin/capture-pilot-scenes.py",
    "cockpit": "apple/bin/install-pilot-chromium.sh --quit-running && open /Applications/Cockpit.app",
    "walkie": "apple/bin/deploy-mobile-app.sh walkie",
    "kneeboard": "apple/bin/deploy-mobile-app.sh kneeboard",
    "ci": "bun run lint && bun run check && bun run test && bun run build && bun run audit",
    "preview": "turbo run preview",
    "deploy": "turbo run deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
